<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.huawei.com/ucmpinterface/common" elementFormDefault="unqualified" attributeFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:common="http://www.huawei.com/ucmpinterface/common">
  <xs:simpleType name="Action">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1"/>
      <xs:enumeration value="U" id="Update"/>
      <xs:enumeration value="I" id="Insert"/>
      <xs:enumeration value="D" id="Delete"/>
      <xs:enumeration value="A" id="Add"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Gender">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1"/>
      <xs:enumeration value="1" id="Male"/>
      <xs:enumeration value="2" id="Female"/>
      <xs:enumeration value="3" id="NA-Organization"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Date">
    <xs:restriction base="xs:string">
      <xs:maxLength value="12"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateTime">
    <xs:restriction base="xs:string">
      <xs:maxLength value="30"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Week">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1"/>
      <xs:enumeration value="0" id="Sunday"/>
      <xs:enumeration value="1" id="Monday"/>
      <xs:enumeration value="2" id="Tuesday"/>
      <xs:enumeration value="3" id="Wednesday"/>
      <xs:enumeration value="4" id="Thursday"/>
      <xs:enumeration value="5" id="Friday"/>
      <xs:enumeration value="6" id="Saturday"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="UserList">
    <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="User" type="common:User"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="PaidMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="0" id="Prepaid"/>
      <xs:enumeration value="1" id="Postpaid"/>
      <xs:enumeration value="2" id="Hybrid"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IMSI">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ICCID">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IMEI">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SubscriberNo">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OfferType">
    <xs:restriction base="xs:int">
      <xs:enumeration value="0" id="PrimaryOffer"/>
      <xs:enumeration value="1" id="OptionalOffer"/>
      <xs:enumeration value="2" id="CUGOffer"/>
      <xs:enumeration value="3" id="GroupOffer"/>
      <xs:enumeration value="4" id="GroupMemberOffer"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OfferLevel">
    <xs:restriction base="xs:int">
      <xs:enumeration value="0" id="SubscriberLevel"/>
      <xs:enumeration value="1" id="AccountLevel"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ProductType">
    <xs:restriction base="xs:int">
      <xs:enumeration value="0" id="AppendantServiceProduct"/>
      <xs:enumeration value="1" id="AppendantTariffProduct"/>
      <xs:enumeration value="2" id="IndividualIncentiveProduct"/>
      <xs:enumeration value="3" id="GroupIncentiveProduct"/>
      <xs:enumeration value="20" id="MainProduct"/>
      <xs:enumeration value="21" id="GroupProduct"/>
      <xs:enumeration value="22" id="CUGProduct"/>
      <xs:enumeration value="23" id="GroupMemberProduct"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Boolean">
    <xs:restriction base="xs:string">
      <xs:maxLength value="1"/>
      <xs:enumeration value="Y" id="Yes"/>
      <xs:enumeration value="N" id="No"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="decimal-or-empty">
    <xs:union memberTypes="xs:decimal common:empty-string"/>
  </xs:simpleType>
  <xs:simpleType name="empty-string">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="UsernameToken">
    <xs:sequence>
      <xs:element name="Username" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*XML Signature – Currently Not Used)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Password" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*XML Signature – Currently Not Used)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SecurityType">
    <xs:sequence>
      <xs:element name="UsernameToken" type="common:UsernameToken"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RequestHeader">
    <xs:annotation>
      <xs:documentation>for user information use(add,modify,delete)</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="FunctionId">
        <xs:annotation>
          <xs:documentation>(*Function Id element will determine the function
    				itself. ESB provide special value according special
    				interface)*)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:int">
            <xs:totalDigits value="8"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Version" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Version ID,current version is 1</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="24"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="TransactionId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Transaction ID,used to compound session, default
    				null )</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="SubTransactionId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Sequence ID,used to compound session,default 1)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestId">
        <xs:annotation>
          <xs:documentation>(*Serial number of a request, which must be unique.)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="64"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestorId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*OM – Oman mobile)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestorChannelId">
        <xs:annotation>
          <xs:documentation>(*The id of the caller)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestorUserId">
        <xs:annotation>
          <xs:documentation>(*User ID of the caller)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestorLanguage" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*E/A for English or Arabic)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestorSecurityInfo" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*XML Signature – Currently Not Used)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="128"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Timestamp" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Request call time yyyy-MM-dd HH:mm:ss.SSS)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:dateTime"/>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Security" type="common:SecurityType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ResponseHeader">
    <xs:sequence>
      <xs:element name="FunctionId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Function Id element will determine the function itself. ESB provide special value according special interface)*)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:int">
            <xs:totalDigits value="8"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="TransactionId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Transaction ID,used to compound session, default null )</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="SubTransactionId" minOccurs="0">
        <xs:annotation>
          <xs:documentation>(*Sequence ID,used to compound session,default 1)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="RequestId">
        <xs:annotation>
          <xs:documentation>(*Serial number of a request, which must be unique.)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="ReturnCode">
        <xs:annotation>
          <xs:documentation>Indicates a code of success/failure, failure reasons.                              405000000: success                Other values: failure reasons</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="ReturnDesc">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="256"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
